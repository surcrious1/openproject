number=[]
name=[]
eng=[]
c=[]
py=[]
ssum=[]
avg=[]
grade=[]

def get_info():
    try:
        num = int(input('학번을 입력하세요 : '))
        number.append(num)
        
        nname = input('이름을 입력하세요 : ')
        name.append(nname)
        
        en = int(input('영어 성적을 입력하세요 : '))
        eng.append(en)
        
        cl = int(input('C언어 성적을 입력하세요 : '))
        c.append(cl)
        
        python = int(input('Python 성적을 입력하세요 : '))
        py.append(python)
    except Exception as e:
        print(e)
        number.append(0)
        name.append("Unknown")
        eng.append(0)
        c.append(0)
        py.append(0)


def sum_avg(i):
    s=eng[i]+c[i]+py[i]
    ssum.append(s)
    avg.append(s/3)

def gradef(i):
    if avg[i] >= 95:
        grade.append("A+") 
    elif avg[i] >= 90:
        grade.append("A") 
    elif avg[i] >= 85:
        grade.append("B+") 
    elif avg[i] >= 80:
        grade.append("B") 
    elif avg[i] >= 75:
        grade.append("C+") 
    elif avg[i] >= 70:
        grade.append("C") 
    elif avg[i] >= 65:
        grade.append("D+") 
    elif avg[i] >= 60:
        grade.append("D") 
    else:
        grade.append("F") 

def rate():
    #내림차순 정렬/큰값이 앞으로 오도록 insert함수 활용
    #기본값 설정
    for i in range(5):
        for j in range(i,5):
            if avg[i]<avg[j]: 
                insertf(i,j)
                deletef(j+1)

def print_all():
    print("학번","이름","영어","C언어","Python","학점","등수",sep='\t')
    for i in range(len(avg)): print(number[i],name[i],eng[i],c[i],py[i],grade[i],i+1,sep='\t')
                

def insertf(i,j):
    #큰 값(j)를 작은 값(i) 앞으로 정렬, 변경
    number.insert(i,number[j])
    name.insert(i,name[j])
    eng.insert(i,eng[j])
    c.insert(i,c[j])
    py.insert(i,py[j])
    avg.insert(i,avg[j])
    ssum.insert(i,ssum[j])
    grade.insert(i,grade[j])

def deletef(i):
    #i라는 위치를 받고 pop하여 삭제
    number.pop(i)
    name.pop(i)
    eng.pop(i)
    c.pop(i)
    py.pop(i)
    avg.pop(i)
    ssum.pop(i)
    grade.pop(i)


def find_number_name():
    print("학번 = ")
    n=input()
    print("학번 위치 = ",number.index(n))
    print("이름 = ")
    n=input()
    print("학번 위치 = ",name.index(n))


def sort_sum():
    #ssum과 별개의 리스트에 저장, ssum의 값을 해당 리스트에 저장
    addall=[]
    for i in range(5):addall.append(ssum[i])
    #오름차순 정렬 후 출력
    for i in range(5):
        for j in range(i,5):
            if addall[i]>addall[j]:
                addall.insert(i,addall[j])
                addall.pop(j+1)
    print("sort sum = ",addall[0],addall[1],addall[2],addall[3],addall[4],sep=' ')

def find_over_80():
    #평균 80점 이상의 학생을 저장할 cnt 선언, 세기, 마지막에 출력
    #80이 넘지 않는 학생을 삭제(deletef 함수 사용)
    cnt=0
    i=0
    print("student, over than 80")
    while i<len(avg): 
        if avg[i]>=80: 
            print(number[i],name[i],eng[i],c[i],py[i],grade[i],i+1,sep='\t')
            cnt+=1
            i+=1
    print("cnt student over than 80 = ",cnt)


for i in range(5):
    get_info()
    sum_avg(i)
    gradef(i)
rate()
print_all()
sort_sum()
find_over_80()

