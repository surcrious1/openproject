#plyaer = 'O', computer = 'X'
#computer의 값을 랜덤하게 출력하기 위한 랜덤 모듈
import random
#변수 선언
tictactoe=[['-','-','-'],['-','-','-'],['-','-','-']]
turn = 0

#player, computer의 입력 중복 제거
#입력 x,y= 0,1,2 중 하나
#x=행,y=열
def player_input():
    while 1:
        x,y=map(int,input("input = ").split())
        if(tictactoe[x][y]=='-'): 
            tictactoe[x][y]='O'
            return x,y
        else: print("input again!")
    
def computer_input():
    while 1:
        x = random.randrange(0, 3)
        y = random.randrange(0, 3)
        if(tictactoe[x][y]=='-'): 
            tictactoe[x][y]='X'
            return x,y
    
def check_line(n):
    #player, computer를 n(turn)으로 구분
    if n%2==0: c='O'
    else: c='X'
    #가로
    for i in range(3):
        if(tictactoe[i][0] == tictactoe[i][1] == tictactoe[i][2] == c): return 1
    #세로
    for i in range(3):
        if(tictactoe[0][i] == tictactoe[1][i] == tictactoe[2][i] == c): return 1
    #대각
    if(tictactoe[0][0] == tictactoe[1][1] == tictactoe[2][2] == c): return 1
    if(tictactoe[0][2] == tictactoe[1][1] == tictactoe[2][0] == c): return 1
    return 0

def who_win(n):
    if n%2==0: print("winner is player!")
    else: print("winner is computer!")
    return 0

def print_tictactoe():
    for i in range(3):
        print(tictactoe[i][0],tictactoe[i][1],tictactoe[i][2],sep='|')
        print("-------------------------------------")

#3X3이기 때문에 9턴 안에 끝나도록
#중간에 승패가 결정되면 break/코드 중지
print("- 주의 : 0,1,2 중에서 입력 -")
while turn < 9:
    #player 선 / computer 후
    line=0
    if turn%2==0:
        x,y=player_input()
        line=check_line(turn)
    else: 
        #computer의 입력은 랜덤하게
        x,y=computer_input()
        print("computer input = ",x,y)
        line=check_line(turn)
    print_tictactoe()
    if line==1: 
        who_win(turn)
        break
    else: turn += 1
#9턴 안에 끝나지 않으면 무승부
if line==0: print("draw!") 
